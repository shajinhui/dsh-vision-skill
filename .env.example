# ============================================================
# 识图 API 配置模板
# 使用方法：把本文件复制为 .env，然后填写 VISION_API_KEY
#   cp .env.example .env
# ============================================================

# 必填：API Key
# 方案一（推荐）：Gemini，key 以 AIza 开头，自动使用 Gemini 原生 API
#   申请: https://aistudio.google.com/apikey
#   VISION_API_KEY=AIza...
# 方案二：阿里云百炼（OpenAI 兼容格式，新用户有免费额度）
#   申请: https://bailian.console.aliyun.com/
VISION_API_KEY=sk-xxx

# 可选：模型名
# 不填时自动选择：Gemini key → gemini-3.1-flash-lite；其他 → qwen-vl-max
# Gemini 其他视觉模型：gemini-2.5-flash / gemini-3.1-flash-lite / gemini-3.5-flash
# 阿里云视觉模型：qwen-vl-max / qwen-vl-plus / qwen2.5-vl-72b-instruct
VISION_MODEL=

# 可选：API Base URL（仅对非 Gemini 服务生效；Gemini 固定走原生 API）
#   阿里云:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:  https://api.openai.com/v1
#   智谱:    https://open.bigmodel.cn/api/paas/v4
#   其他兼容服务填对应地址
# VISION_BASE_URL=
